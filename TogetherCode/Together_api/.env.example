NODE_ENV=development
PORT=3000
API_PREFIX=/v1
ADMIN_PREFIX=/admin
FRONTEND_URL=http://127.0.0.1:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=together
DB_NAME_TEST=together_test
DB_USER=root
DB_PASSWORD=123456
DB_LOGGING=false

REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=replace-me
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ===== 图片上传 =====
# 上传目录与静态访问（未配置 OSS 时的本地回退，开发环境默认）
UPLOAD_DIR=/app/uploads
UPLOAD_PUBLIC_URL=
UPLOAD_MAX_FILES=9
UPLOAD_MAX_SIZE_MB=10

# 阿里云 OSS：配置以下 5 项后，POST /v1/upload 自动切换为 OSS 存储
# （留空则写入本地 UPLOAD_DIR，由 /uploads 静态服务提供）
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_PUBLIC_URL=
