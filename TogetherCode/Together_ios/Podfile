# 艺启 iOS 依赖管理（清华 TUNA CocoaPods 镜像源）
source 'https://mirrors.tuna.tsinghua.edu.cn/git/CocoaPods/Specs.git'

platform :ios, '15.0'

target 'Together_ios' do
  use_frameworks!

  # 网络
  pod 'Alamofire', '~> 5.9'
  # JSON
  pod 'SwiftyJSON', '~> 5.0'
  # 图片
  pod 'Kingfisher', '~> 7.12'
  # 布局
  pod 'SnapKit', '~> 5.7'
  # 图片轮播（纯 Swift 成熟轮子，帖子详情/课程图集复用）
  pod 'FSPagerView', '~> 0.8.3'
  # 刷新（下拉刷新 + 上拉加载，纯 Swift 可定制）
  pod 'ESPullToRefresh', '~> 2.9'
  # HUD
  pod 'MBProgressHUD', '~> 1.2'
  # 键盘
  pod 'IQKeyboardManagerSwift', '~> 7.0'
  # 相册选择（添加孩子自定义头像等场景）
  pod 'HXPhotoPicker', '5.0.5'
end

# 统一所有 pod 的 iOS 最低版本，避免三方库 availability 过低报错
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
